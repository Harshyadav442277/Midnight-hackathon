// NightSeal — privacy-preserving firmware attestation registry.
//
// A device proves in zero knowledge that its firmware measurement is part of the
// registry operator's current approved baseline, without revealing the measurement or
// the component manifest bound into it. The same proof authenticates the registered
// device and checks every hidden component against a separately revocable allowlist.

pragma language_version 0.23;

import CompactStandardLibrary;

export enum Status {
  UNKNOWN,
  COMPLIANT
}

// Leaves are COMMITMENTS to approved firmware measurements, never the measurements
// themselves: Merkle leaves are public ledger state.
export ledger approvedSet: MerkleTree<10, Bytes<32>>;

// A second current-only capability set. Firmware commitments bind a hidden three-slot
// component manifest; every component must remain in this tree for attestation to pass.
export ledger componentSet: MerkleTree<10, Bytes<32>>;

// Bumped on every baseline change (approval or revocation). A device is only current
// if it attested against the present epoch.
export ledger baselineEpoch: Counter;

// Public compliance state, keyed by device id.
export ledger deviceStatus: Map<Bytes<32>, Status>;
export ledger deviceEpoch: Map<Bytes<32>, Uint<64>>;

// Device id -> commitment to a device-held secret. The attestation proves knowledge
// of that secret, so one device cannot write compliance for another device's id.
export ledger registeredDeviceKey: Map<Bytes<32>, Bytes<32>>;

// The registry operator, fixed at deployment.
export ledger operatorPk: Bytes<32>;

// --- private inputs -------------------------------------------------------

// The caller's secret key. Used to authenticate the operator.
witness localSecretKey(): Bytes<32>;

// The device's firmware measurement and the blinding factor the operator issued
// with it. Neither ever reaches the ledger.
witness firmwareMeasurement(): Bytes<32>;
witness firmwareRandomness(): Bytes<32>;

// The fixed-width private component manifest. Three slots keep the hackathon circuit
// static; the firmware commitment binds this exact list so components cannot be swapped.
witness componentMeasurements(): Vector<3, Bytes<32>>;
witness componentRandomness(): Vector<3, Bytes<32>>;

// The Merkle path to this device's commitment, resolved from public ledger state
// by the TypeScript witness (findPathForLeaf is not callable inside a circuit).
witness firmwarePath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness componentPath(commitment: Bytes<32>): MerkleTreePath<10, Bytes<32>>;

// --- helpers --------------------------------------------------------------

export circuit operatorIdentity(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nightseal:operator:"), sk]);
}

export circuit deviceIdentity(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nightseal:device:"), sk]);
}

export circuit componentCommitment(
  measurement: Bytes<32>,
  randomness: Bytes<32>
): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>(
    [pad(32, "nightseal:component:"), measurement],
    randomness
  );
}

// This digest is private. It binds an exact component composition into the approved
// firmware capability without exposing the component commitments or their ordering.
export circuit componentManifest(components: Vector<3, Bytes<32>>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "nightseal:manifest:"),
    components[0],
    components[1],
    components[2]
  ]);
}

// Domain-separated commitment to both the firmware measurement and its private
// component-manifest digest.
export circuit firmwareCommitment(
  measurement: Bytes<32>,
  manifest: Bytes<32>,
  randomness: Bytes<32>
): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "nightseal:firmware:"), measurement, manifest],
    randomness
  );
}

constructor() {
  operatorPk = disclose(operatorIdentity(localSecretKey()));
  baselineEpoch.increment(1);
}

// --- operator circuits ----------------------------------------------------

// Bind a public device id to proof-of-knowledge of a private device secret.
export circuit registerDevice(deviceId: Bytes<32>, identity: Bytes<32>): [] {
  assert(operatorPk == operatorIdentity(localSecretKey()), "not the registry operator");
  registeredDeviceKey.insert(disclose(deviceId), disclose(identity));
}

// Approval, revocation, and cover rotation deliberately share one public operation.
// A real approval writes a capability commitment; revocation writes an opaque random
// tombstone for which nobody knows a valid opening. Observers see only a leaf update.
export circuit updateFirmwareLeaf(value: Bytes<32>, index: Uint<64>): [] {
  assert(operatorPk == operatorIdentity(localSecretKey()), "not the registry operator");
  approvedSet.insertIndex(disclose(value), disclose(index));
  baselineEpoch.increment(1);
}

// The component tree uses the same operation-hiding update shape. The chain cannot
// distinguish a component approval from a tombstone revocation or cover rotation.
export circuit updateComponentLeaf(value: Bytes<32>, index: Uint<64>): [] {
  assert(operatorPk == operatorIdentity(localSecretKey()), "not the registry operator");
  componentSet.insertIndex(disclose(value), disclose(index));
  baselineEpoch.increment(1);
}

// --- device circuit -------------------------------------------------------

// Prove membership of this device's firmware in the CURRENT approved baseline.
//
// approvedSet is a plain MerkleTree, so checkRoot accepts only the current root.
// That is deliberate: HistoricMerkleTree would accept any past root and a revoked
// device could keep attesting forever.
export circuit attest(deviceId: Bytes<32>): [] {
  assert(registeredDeviceKey.member(disclose(deviceId)), "device is not registered");
  assert(
    registeredDeviceKey.lookup(disclose(deviceId)) == deviceIdentity(localSecretKey()),
    "attestation secret does not match the registered device"
  );

  const measurements = componentMeasurements();
  const randomness = componentRandomness();
  const c0 = componentCommitment(measurements[0], randomness[0]);
  const c1 = componentCommitment(measurements[1], randomness[1]);
  const c2 = componentCommitment(measurements[2], randomness[2]);
  const manifest = componentManifest([c0, c1, c2]);
  const commitment = firmwareCommitment(
    firmwareMeasurement(),
    manifest,
    firmwareRandomness()
  );
  const path = firmwarePath(commitment);

  assert(
    approvedSet.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))),
    "firmware is not in the current approved baseline"
  );

  assert(
    componentSet.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(componentPath(c0)))),
    "firmware contains a component outside the current approved baseline"
  );
  assert(
    componentSet.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(componentPath(c1)))),
    "firmware contains a component outside the current approved baseline"
  );
  assert(
    componentSet.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(componentPath(c2)))),
    "firmware contains a component outside the current approved baseline"
  );

  deviceStatus.insert(disclose(deviceId), Status.COMPLIANT);
  deviceEpoch.insert(disclose(deviceId), baselineEpoch as Field as Uint<64>);
}
