# secrets — never commit
.env
.env.*
!.env.example

# deps / build
node_modules/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo

# midnight artifacts that are machine-local
.level/
private-state/
# LevelDB store the private-state provider creates at runtime. It holds device secrets,
# firmware measurements, and commitment openings — never commit it.
midnight-level-db/
*-level-db/
logs/
*.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Compiler output. The generated TypeScript decoder IS committed: reading public
# ledger state needs it, and the public auditor deployment has no Compact compiler.
# The proving/verifying keys and ZKIR are large build artifacts — regenerate with
# `npm run compact`.
contract/src/managed/nightseal/keys/
contract/src/managed/nightseal/zkir/
contract/src/managed/nightseal/compiler/

# local scratch files
scratch-*

# local editor/agent tooling state
.claude/
.vercel
.env*
docs/media/annot*.html
nightseal-submission.zip
